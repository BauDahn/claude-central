#!/usr/bin/env bash
# Corre DENTRO del kitty de `sub`: <motor> <modelo> <archivo-prompt> <log>
export PATH="$HOME/.local/bin:$PATH"
for d in "$HOME"/.nvm/versions/node/*/bin; do PATH="$d:$PATH"; done
motor="$1"; modelo="$2"; pf="$3"; log="$4"
export SUB_NOMBRE="$(basename "$pf" .prompt)" AGENTES_HOME="$(dirname "$(dirname "$(readlink -f "$0")")")"
reportar "inicia ($motor ${modelo:-por defecto}) en $PWD"
prompt="$(cat "$pf")"
case "$motor" in
  agy)    cmd=(agy --mode accept-edits ${modelo:+--model "$modelo"} -i "$prompt") ;;
  claude) cmd=(claude ${modelo:+--model "$modelo"} "$prompt") ;;
  codex)  cmd=(codex ${modelo:+-m "$modelo"} "$prompt") ;;
  *) echo "motor desconocido: $motor"; read -r; exit 1 ;;
esac
if command -v script >/dev/null; then script -q -f -c "$(printf '%q ' "${cmd[@]}")" "$log"; else "${cmd[@]}"; fi
rc=$?
reportar "terminó (código $rc)"
[ -n "$SUB_DECISION" ] && central decisiones cerrar "$SUB_DECISION" "$([ $rc = 0 ] && echo terminado || echo error)" >/dev/null 2>&1
