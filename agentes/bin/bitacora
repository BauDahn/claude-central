#!/usr/bin/env bash
# bitacora — alias de `central bitacora`: importa lo nuevo de las sesiones de Claude y muestra el registro único.
# Opciones: --desde 2d, --agente X, --completo, --seguir. (`bitacora --optimizador` -> `central optimizador`)
if [ "$1" = --optimizador ]; then shift; exec central optimizador "$@"; fi
central importar central >/dev/null 2>&1
exec central bitacora "$@"
