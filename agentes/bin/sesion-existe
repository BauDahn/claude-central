#!/usr/bin/env python3
"""sesion-existe <nombre>: exit 0 si hay una sesión de Claude Code con ese nombre (-n), 1 si no."""
import glob, json, os, sys
nombre = sys.argv[1] if len(sys.argv) > 1 else ""
base = os.path.join(os.environ.get("CLAUDE_HOME", os.path.expanduser("~/.claude")), "projects")
for f in glob.glob(os.path.join(base, "*", "*.jsonl")):
    try:
        with open(f, errors="ignore") as fh:
            for i, l in enumerate(fh):
                if i > 200: break
                if '"custom-title"' in l and json.loads(l).get("customTitle") == nombre:
                    sys.exit(0)
    except (OSError, ValueError):
        continue
sys.exit(1)
