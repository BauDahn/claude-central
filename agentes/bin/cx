#!/usr/bin/env python3
"""cx — delega una tarea a un agente Codex (con el modelo barato que corresponde al rol) y devuelve SOLO su resumen.

  cx <rol> [-C dir] [-p proyecto] [-t ID] [--escribir] "tarea"   # tarea nueva
  cx seguir <hilo> "mensaje"                                    # seguir el mismo hilo (reusa caché, más barato)
  cx log [-n N]                                                 # uso por rol + últimas tareas (evidencia para el reto de Codex)
  cx roles                                                      # roles disponibles y su modelo

Roles = perfiles ~/.codex/<rol>.config.toml (modelo, esfuerzo, sandbox). Prompt = roles/<rol>.md + roles/_codex.md.
Cada corrida queda en ~/agentes/estado/codex.jsonl. --escribir habilita escritura en roles de solo lectura (revisor, seguridad, ideas).
"""
import argparse, json, os, shutil, subprocess, sys, tempfile, time
from pathlib import Path

HOME = Path(os.environ.get("AGENTES_HOME", Path.home() / "agentes"))
CODEX_HOME = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
LOG = HOME / "estado" / "codex.jsonl"


def codex_bin():
    p = shutil.which("codex")
    if p:
        return p
    for c in sorted((Path.home() / ".nvm/versions/node").glob("*/bin/codex"), reverse=True):
        return str(c)
    sys.exit("cx: no encuentro el binario de codex (¿instalado con nvm?)")


def perfil(rol):
    f = CODEX_HOME / f"{rol}.config.toml"
    if not f.exists():
        sys.exit(f"cx: no existe el perfil '{rol}' ({f}). Mirá: cx roles")
    d = {}
    for line in f.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            d[k.strip()] = v.strip().strip('"')
    return d


def correr(cmd, env, cwd):
    """Corre codex exec --json; devuelve (mensaje_final, uso, hilo, código)."""
    with tempfile.NamedTemporaryFile("r", suffix=".txt", delete=False) as out:
        outpath = out.name
    cmd = cmd + ["-o", outpath]
    uso = {"input": 0, "cached": 0, "output": 0, "reasoning": 0}
    hilo, err = None, []
    p = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    for line in p.stdout:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        t = ev.get("type")
        if t == "thread.started":
            hilo = ev.get("thread_id") or hilo
        elif t == "turn.completed":
            u = ev.get("usage", {})
            uso["input"] += u.get("input_tokens", 0)
            uso["cached"] += u.get("cached_input_tokens", 0)
            uso["output"] += u.get("output_tokens", 0)
            uso["reasoning"] += u.get("reasoning_output_tokens", 0)
        elif t in ("error", "turn.failed"):
            err.append(json.dumps(ev, ensure_ascii=False)[:500])
    code = p.wait()
    stderr = p.stderr.read()
    final = Path(outpath).read_text().strip() if Path(outpath).exists() else ""
    Path(outpath).unlink(missing_ok=True)
    if not final:
        final = "BLOQUEADO: codex no devolvió mensaje final.\n" + "\n".join(err or [stderr.strip()[-800:]])
    return final, uso, hilo, code


def registrar(reg):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(json.dumps(reg, ensure_ascii=False) + "\n")


def pie(rol, modelo, uso, hilo, dur):
    print(f"\n[cx] {rol} · {modelo} · in {uso['input']} (caché {uso['cached']}) · out {uso['output']} · {dur:.0f}s · hilo {hilo}")


def cmd_tarea(a):
    prof = perfil(a.rol)
    partes = []
    rolmd = HOME / "roles" / f"{a.rol}.md"
    if rolmd.exists():
        partes.append(rolmd.read_text())
    partes.append((HOME / "roles" / "_codex.md").read_text())
    ctx = []
    if a.proyecto:
        ctx.append(f"Proyecto (tablero): {a.proyecto}")
    if a.id:
        ctx.append(f"ID de tarea en el tablero: #{a.id}")
    partes.append("\n".join(ctx + ["", "TAREA:", a.tarea]))
    prompt = "\n\n".join(partes)

    cwd = str(Path(a.C).expanduser().resolve()) if a.C else os.getcwd()
    agente = f"{a.rol}-codex"
    env = dict(os.environ, AGENTE=agente, AGENTES_HOME=str(HOME))
    env["PATH"] = f"{Path.home()}/.local/bin:{env.get('PATH', '')}"
    cmd = [codex_bin(), "exec", "-p", a.rol, "--json", "--skip-git-repo-check", "-C", cwd]
    if a.escribir:
        cmd += ["-s", "workspace-write"]
    cmd.append(prompt)

    tablero = [str(HOME / "bin" / "tareas")]
    if a.id:  # el tablero se maneja acá, fuera del sandbox de Codex
        r = subprocess.run(tablero + ["tomar", a.id, "--como", agente] + (["-p", a.proyecto] if a.proyecto else []),
                           env=env, capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"BLOQUEADO: no pude tomar la tarea #{a.id}: {(r.stdout + r.stderr).strip()}")

    t0 = time.time()
    final, uso, hilo, code = correr(cmd, env, cwd)
    dur = time.time() - t0
    subprocess.run([str(HOME / "bin" / "bloqueo"), "soltar-todo", "--como", agente], env=env,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if a.id:
        primera = final.splitlines()[0] if final else ""
        pr = ["-p", a.proyecto] if a.proyecto else []
        if primera.startswith("LISTO"):
            subprocess.run(tablero + ["listo", a.id, "--nota", primera[:200]] + pr, env=env, capture_output=True)
        else:
            subprocess.run(tablero + ["bloquear", a.id, "--motivo", primera[:200] or "sin mensaje final"] + pr,
                           env=env, capture_output=True)
    registrar({"ts": int(t0), "rol": a.rol, "modelo": prof.get("model"), "esfuerzo": prof.get("model_reasoning_effort"),
               "dir": cwd, "proyecto": a.proyecto, "id": a.id, "tarea": a.tarea[:300], "hilo": hilo,
               "uso": uso, "seg": round(dur), "exit": code, "resultado": final.splitlines()[0][:200] if final else ""})
    print(final)
    pie(a.rol, prof.get("model"), uso, hilo, dur)
    sys.exit(0 if code == 0 else 1)


def cmd_seguir(a):
    prev = None
    if LOG.exists():
        for line in LOG.read_text().splitlines():
            r = json.loads(line)
            if r.get("hilo") == a.hilo:
                prev = r
    if not prev:
        sys.exit(f"cx: no encuentro el hilo {a.hilo} en {LOG}")
    rol, cwd = prev["rol"], prev["dir"]
    agente = f"{rol}-codex"
    env = dict(os.environ, AGENTE=agente, AGENTES_HOME=str(HOME))
    env["PATH"] = f"{Path.home()}/.local/bin:{env.get('PATH', '')}"
    cmd = [codex_bin(), "exec", "-p", rol, "--json", "--skip-git-repo-check", "-C", cwd, "resume", a.hilo,
           a.mensaje + "\n\n(Terminá con el mismo formato de mensaje final: LISTO/BLOQUEADO/NECESITA, archivos, verificado.)"]
    t0 = time.time()
    final, uso, hilo, code = correr(cmd, env, cwd)
    dur = time.time() - t0
    subprocess.run([str(HOME / "bin" / "bloqueo"), "soltar-todo", "--como", agente], env=env,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    registrar({"ts": int(t0), "rol": rol, "modelo": prev.get("modelo"), "esfuerzo": prev.get("esfuerzo"), "dir": cwd,
               "proyecto": prev.get("proyecto"), "id": prev.get("id"), "tarea": "(seguir) " + a.mensaje[:280],
               "hilo": a.hilo, "uso": uso, "seg": round(dur), "exit": code,
               "resultado": final.splitlines()[0][:200] if final else ""})
    print(final)
    pie(rol, prev.get("modelo"), uso, a.hilo, dur)
    sys.exit(0 if code == 0 else 1)


def cmd_log(a):
    if not LOG.exists():
        print("cx: todavía no hay corridas registradas")
        return
    regs = [json.loads(l) for l in LOG.read_text().splitlines() if l.strip()]
    tot = {}
    for r in regs:
        t = tot.setdefault(r["rol"], {"n": 0, "in": 0, "out": 0, "seg": 0, "modelo": r.get("modelo")})
        t["n"] += 1
        t["in"] += r["uso"]["input"]
        t["out"] += r["uso"]["output"] + r["uso"]["reasoning"]
        t["seg"] += r["seg"]
    print(f"{'rol':<12} {'modelo':<14} {'tareas':>6} {'tokens in':>10} {'tokens out':>10} {'min':>6}")
    for rol, t in sorted(tot.items(), key=lambda x: -x[1]["in"]):
        print(f"{rol:<12} {t['modelo'] or '-':<14} {t['n']:>6} {t['in']:>10} {t['out']:>10} {t['seg']/60:>6.1f}")
    print(f"\nÚltimas {a.n}:")
    for r in regs[-a.n:]:
        print(f"- {time.strftime('%d/%m %H:%M', time.localtime(r['ts']))} [{r['rol']}] {r['tarea'][:80]} → {r['resultado'][:80]}")


def cmd_roles(_):
    for f in sorted(CODEX_HOME.glob("*.config.toml")):
        d = perfil(f.name.split(".")[0])
        print(f"{f.name.split('.')[0]:<12} {d.get('model', '-'):<14} esfuerzo {d.get('model_reasoning_effort', '-'):<7} sandbox {d.get('sandbox_mode', '-')}")


def main():
    sub = sys.argv[1] if len(sys.argv) > 1 else "-h"
    if sub in ("-h", "--help"):
        print(__doc__)
        return
    if sub == "seguir":
        ap = argparse.ArgumentParser(prog="cx seguir")
        ap.add_argument("hilo"); ap.add_argument("mensaje")
        return cmd_seguir(ap.parse_args(sys.argv[2:]))
    if sub == "log":
        ap = argparse.ArgumentParser(prog="cx log")
        ap.add_argument("-n", type=int, default=15)
        return cmd_log(ap.parse_args(sys.argv[2:]))
    if sub == "roles":
        return cmd_roles(None)
    ap = argparse.ArgumentParser(prog="cx")
    ap.add_argument("rol"); ap.add_argument("tarea")
    ap.add_argument("-C", help="directorio de trabajo (def. el actual)")
    ap.add_argument("-p", "--proyecto"); ap.add_argument("-t", "--id")
    ap.add_argument("--escribir", action="store_true")
    cmd_tarea(ap.parse_args(sys.argv[1:]))


if __name__ == "__main__":
    main()
