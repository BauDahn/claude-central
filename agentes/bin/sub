#!/usr/bin/env bash
# sub <motor> [modelo] <directorio> "tarea"   — lanza un subagente de cualquier IA en un kitty (sin robar foco).
#   motor: agy | claude | codex      modelo: nombre exacto (agy: "Gemini 4 Hydrogen (High)"; claude: opus|sonnet|haiku)
#   sub --modelos            lista los modelos de agy
#   sub --lista [nombre]     subagentes lanzados (abiertos/cerrados)
#   La tarea puede ser @archivo.txt. Opciones: --nombre X  --ws N  --aprobado --motivo "..." (OBLIGATORIO --aprobado: el usuario elige o aprueba el motor/modelo; `sub --opciones` lista lo disponible)
# Queda registrado en estado/subs.json; log de la terminal en estado/subs/<nombre>.log
source "$(dirname "$(readlink -f "$0")")/_lib.sh"
SUBS="$ESTADO/subs"; mkdir -p "$SUBS"; REG="$ESTADO/subs.json"; [ -s "$REG" ] || echo '{}' > "$REG"
case "$1" in
  --opciones) echo "== Catálogo de central (central modelos) =="; central modelos; echo; echo "== Modelos de agy (agy) =="; agy --model x -p x 2>&1 | sed -n '/Available models/,$p' | tail -n +2; echo; echo "motores: agy | claude (opus|sonnet|haiku) | codex (gpt-6-luna)"; exit 0 ;;
  --modelos) agy --model x -p x 2>&1 | sed -n '/Available models/,$p'; exit 0 ;;
  --lista)
    filtro="${2:-}"
    aliases="$(central nombre alias 2>/dev/null || echo '{}')"
    clients="$(hyprctl clients -j 2>/dev/null || echo '[]')"
    jq -rn --argjson r "$(cat "$REG")" --argjson a "$aliases" --argjson c "$clients" --arg f "$filtro" '
      def abierto($k; $al): ([$c[]?.class] | any(. == ("agente-" + $k) or ($al != null and . == ("agente-" + $al))));
      $r | to_entries[] |
      .key as $k | ($a[$k] // null) as $al |
      select($f == "" or $k == $f or $al == $f) |
      (if $al then "\($al) (\($k))" else $k end) as $disp |
      "\($disp)\t\(if abierto($k; $al) then "abierto" else "cerrado" end)\t\(.value.motor)\t\(.value.modelo)\t\(.value.ts|todate)\t\(.value.dir)"
    ' | while IFS=$'\t' read -r n e m mo t d; do
      printf '%-20s %-8s %-9s %-26s %s %s\n' "$n" "$e" "$m" "$mo" "$t" "$d"
    done
    exit 0 ;;
esac
nombre=""; ws=""; pos=(); aprobado=0; motivo=""
while [ $# -gt 0 ]; do case "$1" in --nombre) nombre="$2"; shift 2;; --ws) ws="$2"; shift 2;; --aprobado) aprobado=1; shift;; --motivo) motivo="$2"; shift 2;; *) pos+=("$1"); shift;; esac; done
motor="${pos[0]}"
case "$motor" in agy|claude|codex) ;; *) echo "uso: sub <agy|claude|codex> [modelo] <dir> \"tarea\" | --modelos | --lista"; exit 2;; esac
if [ "${#pos[@]}" -ge 4 ]; then modelo="${pos[1]}"; dir="${pos[2]}"; tarea="${pos[3]}"; else modelo=""; dir="${pos[1]}"; tarea="${pos[2]}"; fi
if [ "$aprobado" != 1 ]; then
  echo "SIN APROBACIÓN: antes de lanzar hay que proponerle al usuario motor y modelo (con el motivo) y esperar su OK." >&2
  echo "  Opciones: sub --opciones   |   Al tener el OK: agregá --aprobado --motivo \"por qué este motor/modelo\"" >&2; exit 3
fi
dir="${dir/#\~/$HOME}"; [ -d "$dir" ] || { echo "no existe el directorio: $dir"; exit 1; }
[ -n "$tarea" ] || { echo "falta la tarea"; exit 2; }
[[ "$tarea" == @* ]] && tarea="$(cat "${tarea#@}")"
ocup_args=()
while IFS= read -r c; do
  [ -n "$c" ] && ocup_args+=(--ocupado "$c")
done < <(hyprctl clients -j 2>/dev/null | jq -r '.[]? | .class // empty | select(startswith("agente-")) | sub("^agente-"; "")' 2>/dev/null || true)
if [ -n "$nombre" ]; then
  central nombre asignar --nombre "$nombre" >/dev/null 2>&1 || true
else
  nombre="$(central nombre asignar "${ocup_args[@]}" 2>/dev/null)" || nombre="$motor-$(date +%H%M%S)"
fi
pf="$SUBS/$nombre.prompt"; log="$SUBS/$nombre.log"
printf '%s\n\n---\nCOORDINACIÓN: sos un subagente lanzado por central. Hay un log compartido que central lee en vivo. Usá el comando `reportar "mensaje corto"` (en el PATH) al empezar cada etapa, al terminar cada hito, cuando te bloquees o necesites una decisión del usuario, y al finalizar con un resumen de lo hecho. Para ver lo que reportan los demás: `sublog`.\n' "$tarea" > "$pf"
[ -n "$ws" ] || ws="$(hyprctl activeworkspace -j | jq -r '.id')"
did="$(central decisiones registrar --motor "$motor" --modelo "$modelo" --origen sub --dir "$dir" --nombre "$nombre" --motivo "$motivo" --prompt-file "$pf" 2>/dev/null)" || did=""
cmd="env SUB_DECISION=$did kitty --class agente-$nombre --title $nombre -d '$dir' '$ROOT/bin/_sub' '$motor' '$modelo' '$pf' '$log'"
out="$(hyprctl dispatch "hl.dsp.exec_cmd([==[$cmd]==], { workspace = \"$ws silent\" })" 2>&1)"
[ "$out" = ok ] || { echo "error al lanzar: $out" >&2; exit 1; }
jq --arg n "$nombre" --arg m "$motor" --arg mo "$modelo" --arg d "$dir" '.[$n]={motor:$m,modelo:$mo,dir:$d,ts:(now|floor)}' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
echo "lanzado '$nombre' ($motor ${modelo:-modelo por defecto}) en $dir, workspace $ws. Log: $log"
