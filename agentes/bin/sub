#!/usr/bin/env bash
# sub <motor> [modelo] <directorio> "tarea"   — lanza un subagente de cualquier IA en un kitty (sin robar foco).
#   motor: agy | claude | codex      modelo: nombre exacto (agy: "Gemini 4 Hydrogen (High)"; claude: opus|sonnet|haiku)
#   sub --modelos            lista los modelos de agy
#   sub --lista              subagentes lanzados (abiertos/cerrados)
#   La tarea puede ser @archivo.txt. Opciones: --nombre X  --ws N
# Queda registrado en estado/subs.json; log de la terminal en estado/subs/<nombre>.log
source "$(dirname "$(readlink -f "$0")")/_lib.sh"
SUBS="$ESTADO/subs"; mkdir -p "$SUBS"; REG="$ESTADO/subs.json"; [ -s "$REG" ] || echo '{}' > "$REG"
case "$1" in
  --modelos) agy --model x -p x 2>&1 | sed -n '/Available models/,$p'; exit 0 ;;
  --lista)
    jq -r 'to_entries[]|"\(.key)\t\(.value.motor)\t\(.value.modelo)\t\(.value.dir)\t\(.value.ts|todate)"' "$REG" |
    while IFS=$'\t' read -r n m mo d t; do
      hyprctl clients -j | jq -e --arg c "agente-$n" '.[]|select(.class==$c)' >/dev/null && e=abierto || e=cerrado
      printf '%-14s %-8s %-9s %-26s %s %s\n' "$n" "$e" "$m" "$mo" "$t" "$d"; done; exit 0 ;;
esac
nombre=""; ws=""; pos=()
while [ $# -gt 0 ]; do case "$1" in --nombre) nombre="$2"; shift 2;; --ws) ws="$2"; shift 2;; *) pos+=("$1"); shift;; esac; done
motor="${pos[0]}"
case "$motor" in agy|claude|codex) ;; *) echo "uso: sub <agy|claude|codex> [modelo] <dir> \"tarea\" | --modelos | --lista"; exit 2;; esac
if [ "${#pos[@]}" -ge 4 ]; then modelo="${pos[1]}"; dir="${pos[2]}"; tarea="${pos[3]}"; else modelo=""; dir="${pos[1]}"; tarea="${pos[2]}"; fi
dir="${dir/#\~/$HOME}"; [ -d "$dir" ] || { echo "no existe el directorio: $dir"; exit 1; }
[ -n "$tarea" ] || { echo "falta la tarea"; exit 2; }
[[ "$tarea" == @* ]] && tarea="$(cat "${tarea#@}")"
[ -n "$nombre" ] || nombre="$motor-$(date +%H%M%S)"
pf="$SUBS/$nombre.prompt"; log="$SUBS/$nombre.log"
printf '%s\n\n---\nCOORDINACIÓN: sos un subagente lanzado por central. Hay un log compartido que central lee en vivo. Usá el comando `reportar "mensaje corto"` (en el PATH) al empezar cada etapa, al terminar cada hito, cuando te bloquees o necesites una decisión del usuario, y al finalizar con un resumen de lo hecho. Para ver lo que reportan los demás: `sublog`.\n' "$tarea" > "$pf"
[ -n "$ws" ] || ws="$(hyprctl activeworkspace -j | jq -r '.id')"
did="$(central decisiones registrar --motor "$motor" --modelo "$modelo" --origen sub --dir "$dir" --nombre "$nombre" --prompt-file "$pf" 2>/dev/null)" || did=""
cmd="env SUB_DECISION=$did kitty --class agente-$nombre --title $nombre -d '$dir' '$ROOT/bin/_sub' '$motor' '$modelo' '$pf' '$log'"
out="$(hyprctl dispatch "hl.dsp.exec_cmd([==[$cmd]==], { workspace = \"$ws silent\" })" 2>&1)"
[ "$out" = ok ] || { echo "error al lanzar: $out" >&2; exit 1; }
jq --arg n "$nombre" --arg m "$motor" --arg mo "$modelo" --arg d "$dir" '.[$n]={motor:$m,modelo:$mo,dir:$d,ts:(now|floor)}' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
echo "lanzado '$nombre' ($motor ${modelo:-modelo por defecto}) en $dir, workspace $ws. Log: $log"
