#!/usr/bin/env bash
# listar — agentes definidos, estado y workspace real de cada ventana.
source "$(dirname "$(readlink -f "$0")")/bin/_lib.sh"
printf '%-14s %-9s %-10s %s\n' AGENTE ESTADO WORKSPACE DIRECTORIO
for n in $(agente_nombres); do
  IFS='|' read -r _ dir _ <<<"$(agente_linea "$n")"
  v="$(agente_ventana "$n")"
  if [ -n "$v" ]; then est=abierto; ws="$(jq -r '.workspace.name' <<<"$v")"; else est=cerrado; ws=-; fi
  printf '%-14s %-9s %-10s %s\n' "$n" "$est" "$ws" "$dir"
done
